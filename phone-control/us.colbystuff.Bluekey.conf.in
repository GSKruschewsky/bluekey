<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- Generated by phone-control/install-system.sh from phone-control/us.colbystuff.Bluekey.conf.in.
     Stricter than bluekey/install/us.colbystuff.Bluekey.conf: bluekeyd can grab any input device and forward
     it over Bluetooth, so only the daemon may own the name and only one desktop user may talk to it. -->
<busconfig>
  <policy user="bluekey">
    <allow own="us.colbystuff.Bluekey"/>
  </policy>
  <policy user="@USER@">
    <allow send_destination="us.colbystuff.Bluekey"/>
  </policy>
</busconfig>
